# Copy this file to .env.local and insert your Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
# DO NOT COMMIT .env.local to GitHub.
# In Vercel, configure this variable in Project Settings -> Environment Variables.
# ==============================================================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

